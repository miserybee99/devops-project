pipeline {
    agent any

    parameters {
        string(name: 'backoffice-bff',    defaultValue: 'main', description: 'Name of Working Branch (vd: dev_backoffice_bff)')
        string(name: 'backoffice-ui',     defaultValue: 'main', description: 'Name of Working Branch (vd: dev_backoffice_ui)')
        string(name: 'cart-service',      defaultValue: 'main', description: 'Name of Working Branch (vd: dev_cart_service)')
        string(name: 'customer-service',  defaultValue: 'main', description: 'Name of Working Branch (vd: dev_customer_service)')
        string(name: 'inventory-service', defaultValue: 'main', description: 'Name of Working Branch (vd: dev_inventory_service)')
        string(name: 'location-service',  defaultValue: 'main', description: 'Name of Working Branch (vd: dev_location_service)')
        string(name: 'media-service',     defaultValue: 'main', description: 'Name of Working Branch (vd: dev_media_service)')
        string(name: 'order-service',     defaultValue: 'main', description: 'Name of Working Branch (vd: dev_order_service)')
        string(name: 'product-service',   defaultValue: 'main', description: 'Name of Working Branch (vd: dev_product_service)')
        string(name: 'rating-service',    defaultValue: 'main', description: 'Name of Working Branch (vd: dev_rating_service)')
        string(name: 'search-service',    defaultValue: 'main', description: 'Name of Working Branch (vd: dev_search_service)')
        string(name: 'storefront-bff',    defaultValue: 'main', description: 'Name of Working Branch (vd: dev_storefront_bff)')
        string(name: 'storefront-ui',     defaultValue: 'main', description: 'Name of Working Branch (vd: dev_storefront_ui)')
        string(name: 'tax-service',       defaultValue: 'main', description: 'Name of Working Branch (vd: dev_tax_service)')
    }

    environment {
        NAMESPACE      = 'yas'
        DOMAIN         = 'yas.local.com'
        DOCKERHUB_USER = 'bync'
        CHARTS_PATH    = 'k8s/charts'
        GIT_REPO       = 'https://github.com/miserybee99/devops-project.git'
    }

    stages {

        stage('Resolve Tags') {
            steps {
                script {
                    def services = [
                        "cart", "customer", "inventory", "location", "media",
                        "order", "product", "rating", "search", "tax",
                        "backoffice-bff", "backoffice-ui", "storefront-bff", "storefront-ui"
                    ]

                    def serviceTags = [:]

                    for (svc in services) {
                        def paramName = (svc in ["backoffice-bff", "backoffice-ui", "storefront-bff", "storefront-ui"])
                            ? svc
                            : "${svc}-service"

                        def branch = params[paramName] ?: 'main'
                        def tag    = 'latest'

                        if (branch != 'main') {
                            def commitId = sh(
                                script: """
                                    git ls-remote ${GIT_REPO} refs/heads/${branch} \
                                    | awk '{print substr(\$1,1,8)}'
                                """,
                                returnStdout: true
                            ).trim()

                            if (commitId) {
                                tag = commitId
                                echo "[${svc}] Branch: ${branch} → Tag: ${tag}"
                            } else {
                                echo "[${svc}] WARNING: Not found branch '${branch}', fallback to latest"
                            }
                        } else {
                            echo "[${svc}] Branch: main → Tag: latest"
                        }

                        serviceTags[svc] = tag
                    }

                    env.SERVICE_TAGS = groovy.json.JsonOutput.toJson(serviceTags)
                    echo "SERVICE_TAGS: ${env.SERVICE_TAGS}"
                }
            }
        }

        stage('Deploy Configuration') {
            steps {
                sh """
                    helm dependency build ${CHARTS_PATH}/yas-configuration
                    helm upgrade --install yas-configuration ${CHARTS_PATH}/yas-configuration \
                        --namespace ${NAMESPACE} --create-namespace
                """
            }
        }

        stage('Deploy Applications') {
            steps {
                script {
                    def serviceTags = readJSON text: env.SERVICE_TAGS
                    def services = [
                        "cart", "customer", "inventory", "location", "media",
                        "order", "product", "rating", "search", "tax"
                    ]

                    for (svc in services) {
                        def tag = serviceTags[svc] ?: 'latest'
                        echo "Deploying ${svc} with tag: ${tag}"
                        sh """
                            helm dependency build ${CHARTS_PATH}/${svc} --skip-refresh || true
                            helm upgrade --install ${svc} ${CHARTS_PATH}/${svc} \
                                --namespace ${NAMESPACE} \
                                --create-namespace \
                                --set backend.ingress.host=api.${DOMAIN} \
                                --set backend.image.repository=${DOCKERHUB_USER}/${svc} \
                                --set backend.image.tag=${tag} \
                                --wait --timeout 3m \
                            || true
                        """
                    }
                }
            }
        }

        stage('Deploy Backoffice Layer') {
            steps {
                script {
                    def serviceTags = readJSON text: env.SERVICE_TAGS
                    def bffTag = serviceTags['backoffice-bff'] ?: 'latest'
                    def uiTag  = serviceTags['backoffice-ui']  ?: 'latest'

                    echo "Deploying backoffice-bff with tag: ${bffTag}"
                    sh """
                        helm dependency build ${CHARTS_PATH}/backoffice-bff
                        helm upgrade --install backoffice-bff ${CHARTS_PATH}/backoffice-bff \
                            --namespace ${NAMESPACE} \
                            --set backend.ingress.host=backoffice.${DOMAIN} \
                            --set backend.image.repository=${DOCKERHUB_USER}/backoffice-bff \
                            --set backend.image.tag=${bffTag}
                    """

                    echo "Deploying backoffice-ui with tag: ${uiTag}"
                    sh """
                        helm dependency build ${CHARTS_PATH}/backoffice-ui
                        helm upgrade --install backoffice-ui ${CHARTS_PATH}/backoffice-ui \
                            --namespace ${NAMESPACE} \
                            --set frontend.image.repository=${DOCKERHUB_USER}/backoffice-ui \
                            --set frontend.image.tag=${uiTag}
                    """
                }
            }
        }

        stage('Deploy Storefront Layer') {
            steps {
                script {
                    def serviceTags = readJSON text: env.SERVICE_TAGS
                    def bffTag = serviceTags['storefront-bff'] ?: 'latest'
                    def uiTag  = serviceTags['storefront-ui']  ?: 'latest'

                    echo "Deploying storefront-bff with tag: ${bffTag}"
                    sh """
                        helm dependency build ${CHARTS_PATH}/storefront-bff
                        helm upgrade --install storefront-bff ${CHARTS_PATH}/storefront-bff \
                            --namespace ${NAMESPACE} \
                            --set backend.ingress.host=storefront.${DOMAIN} \
                            --set backend.image.repository=${DOCKERHUB_USER}/storefront-bff \
                            --set backend.image.tag=${bffTag}
                    """

                    echo "Deploying storefront-ui with tag: ${uiTag}"
                    sh """
                        helm dependency build ${CHARTS_PATH}/storefront-ui
                        helm upgrade --install storefront-ui ${CHARTS_PATH}/storefront-ui \
                            --namespace ${NAMESPACE} \
                            --set frontend.image.repository=${DOCKERHUB_USER}/storefront-ui \
                            --set frontend.image.tag=${uiTag}
                    """
                }
            }
        }

        stage('Deploy Swagger UI') {
            steps {
                sh """
                    helm upgrade --install swagger-ui ${CHARTS_PATH}/swagger-ui \
                        --namespace ${NAMESPACE} \
                        --set ingress.host=api.${DOMAIN}
                """
            }
        }
    }

    post {
        success {
            echo "Deploy completed successfully!"
        }
        failure {
            echo "Deploy failed. Watch logs for details."
        }
    }
}
