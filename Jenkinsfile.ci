pipeline {
    agent any

    environment {
        DOCKERHUB_USR = "bync"
        DOCKERHUB_CREDS = "dockerhub-credentials"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Prepare') {
            steps {
                script {
                    def commitId = sh(
                            script: "git rev-parse --short HEAD",
                            returnStdout: true
                        ).trim()
    
                    env.COMMIT_ID = commitId
                    echo "COMMIT_ID: ${env.COMMIT_ID}"

                    def currentBranch = env.BRANCH_NAME ?: sh(
                        script: "git rev-parse --abbrev-ref HEAD",
                        returnStdout: true
                    ).trim()
                    env.CURRENT_BRANCH = currentBranch
                    echo "Current branch: ${env.CURRENT_BRANCH}"

                    if (currentBranch == "feature/gitops") {
                        def gitTag = sh(
                            script: "git tag --points-at HEAD | grep -E '^v[0-9]+\\.[0-9]+\\.[0-9]+' || true",
                            returnStdout: true
                        ).trim()

                        if (gitTag) {
                            env.DEPLOY_ENV = "staging"
                            env.EXTRA_TAG = gitTag
                        } else {
                            env.DEPLOY_ENV = "dev"
                            env.EXTRA_TAG = "latest"
                        }
                        echo "Main branch → EXTRA_TAG: ${env.EXTRA_TAG}"
                    } else {
                        env.DEPLOY_ENV = ""
                        env.EXTRA_TAG = ""
                        echo "Non-main branch → no extra tag"
                    }
                }
            }
        }

        stage('Detect Changes') {
            steps {
                script {
                    def backendServices = [
                        'common-library', 'backoffice-bff', 'cart', 'customer', 'delivery', 'inventory',
                        'location', 'media', 'order', 'payment', 'payment-paypal', 'product', 'promotion',
                        'rating', 'recommendation', 'sampledata', 'search', 'storefront-bff', 'tax', 'webhook'
                    ]

                    def frontendServices = [ 'storefront', 'backoffice' ]

                    def changedFiles = []
                    try {
                        changedFiles = sh(
                            script: "git diff --name-only HEAD~1 HEAD",
                            returnStdout: true
                        ).trim().split('\n').findAll { it }
                    } catch (e) {
                        echo "Could not detect changes (first build?). Building all services."
                        env.CHANGED_BACKEND_SERVICES  = backendServices.join(',')
                        env.CHANGED_FRONTEND_SERVICES = frontendServices.join(',')
                        return
                    }

                    echo "Changed files:\n${changedFiles.join('\n')}"

                    def changedBackend  = [] as Set
                    def changedFrontend = [] as Set

                    def rootPomChanged = changedFiles.any { it == 'pom.xml' }
                    def commonLibChanged = changedFiles.any { it.startsWith('common-library/') } || rootPomChanged

                    if (commonLibChanged) {
                        changedBackend.addAll(allServices)
                    }

                    for (file in changedFiles) {
                        def service = allServices.find { file.startsWith("${it}/") }
                        if (service) changedBackend.add(service)

                        def frontend = frontendServices.find { file.startsWith("${it}/") }
                        if (frontend) changedFrontend.add(frontend)
                    }

                    env.CHANGED_BACKEND_SERVICES  = changedBackend ? changedBackend.toList().join(',') : ''
                    env.CHANGED_FRONTEND_SERVICES = changedFrontend ? changedFrontend.toList().join(',') : ''

                    def allChanged = []
                    allChanged.addAll(changedBackend)
                    allChanged.addAll(changedFrontend)
                    env.CHANGED_SERVICES = allChanged ? allChanged.join(',') : ''

                    echo "Backend services to build:  ${env.CHANGED_BACKEND_SERVICES ?: '(none)'}"
                    echo "Frontend services to build: ${env.CHANGED_FRONTEND_SERVICES ?: '(none)'}"
                }
            }
        }
        
        stage('Build Services') {
            steps {
                script {
                    if (env.CHANGED_FRONTEND_SERVICES) {
                        for (svc in env.CHANGED_FRONTEND_SERVICES) {
                            echo "Building UI service: ${svc} (npm)"
                            sh """
                                cd ${svc}
                                npm install --prefer-offline
                                npm run build
                                cd ..
                            """
                        }
                    }

                    if (env.CHANGED_BACKEND_SERVICES) {
                        sh "chmod +x mvnw"
                        def modules = env.CHANGED_BACKEND_SERVICES.join(",")
                        echo "Building backend services: ${modules} (Maven)"
                        sh "./mvnw clean install -pl ${modules} -am -DskipTests"
                    }
                }
            }
        }

        stage('Docker Login') {
            when {
                expression { return env.CHANGED_SERVICES != "" }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: DOCKERHUB_CREDS,
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh '''
                    echo "$PASS" | docker login -u "$USER" --password-stdin
                    '''
                }
            }
        }

        stage('Build & Push Images') {
            when {
                expression { return env.CHANGED_SERVICES != "" }
            }
            steps {
                script {
                    def services = env.CHANGED_SERVICES.split(",")

                    for (svc in services) {
                        def image = "${DOCKERHUB_USR}/${svc}"

                        echo "Building ${svc}..."

                        sh """
                        docker build \
                            --no-cache \
                            -t ${image}:${COMMIT_ID} \
                            -f ${svc}/Dockerfile ./${svc}
                        """
                        retry(3) {
                            sh "docker push ${image}:${env.COMMIT_ID}"
                        }
                        
                        if (env.EXTRA_TAG) {
                            echo "Tagging ${image}:${env.COMMIT_ID} → ${image}:${env.EXTRA_TAG}"
                            sh "docker tag ${image}:${env.COMMIT_ID} ${image}:${env.EXTRA_TAG}"
                            retry(3) {
                                sh "docker push ${image}:${env.EXTRA_TAG}"
                            }
                        }
                    }
                }
            }
        }

        stage('Trigger Deploy') {
            when {
                expression { 
                    return env.CHANGED_SERVICES != "" && env.DEPLOY_ENV != ""
                }
            }
            steps {
                script {
                    build job: 'developer_deploy',
                        wait: false,
                        parameters: [
                            string(name: 'DEPLOY_ENV',       value: env.DEPLOY_ENV),
                            string(name: 'IMAGE_TAG',        value: env.EXTRA_TAG),
                            string(name: 'CHANGED_SERVICES', value: env.CHANGED_SERVICES)
                        ]
                }
            }
        }
    }

    post {
        always {
            script {
                if (env.CHANGED_SERVICES) {
                    def services = env.CHANGED_SERVICES.split(",")
                    for (svc in services) {
                        def image = "${DOCKERHUB_USR}/${svc}"
                        sh "docker rmi ${image}:${env.COMMIT_ID} || true"
                        if (env.EXTRA_TAG) {
                            sh "docker rmi ${image}:${env.EXTRA_TAG} || true"
                        }
                    }
                }
            }
        }
        success { echo "Pipeline completed successfully!" }
        failure { echo "Pipeline failed. Check logs for details." }
    }
}
