pipeline {
    agent any

    environment {
        DOCKERHUB_USR = "bync"
        DOCKERHUB_CREDS = "dockerhub-credentials"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }
        
        stage('Prepare') {
            steps {
                script {
                    def commitId = env.GIT_COMMIT?.take(8)
    
                    if (!commitId) {
                        echo "GIT_COMMIT null, fallback to git rev-parse"
                        commitId = sh(
                            script: "git rev-parse --short HEAD",
                            returnStdout: true
                        ).trim()
                    }
    
                    env.COMMIT_ID = commitId
                    echo "COMMIT_ID: ${env.COMMIT_ID}"

                    def currentBranch = env.BRANCH_NAME ?: sh(
                        script: "git rev-parse --abbrev-ref HEAD",
                        returnStdout: true
                    ).trim()
                    env.CURRENT_BRANCH = currentBranch
                    echo "Current branch: ${env.CURRENT_BRANCH}"

                    if (currentBranch == "feature/gitops") {
                        def gitTag = sh(
                            script: "git tag --points-at HEAD | grep -E '^v[0-9]+\\.[0-9]+\\.[0-9]+' || true",
                            returnStdout: true
                        ).trim()

                        if (gitTag) {
                            env.DEPLOY_ENV = "staging"
                            env.IMAGE_TAG   = gitTag
                        } else {
                            env.DEPLOY_ENV = "dev"
                            env.IMAGE_TAG   = commitId
                        }

                        echo "Deploy environment : ${env.DEPLOY_ENV}"
                        echo "Image tag          : ${env.IMAGE_TAG}"
                    } else {
                        env.DEPLOY_ENV = "none"
                        env.IMAGE_TAG  = commitId
                    }
                }
            }
        }

        stage('Detect Changed Services') {
            steps {
                script {
                    if (env.DEPLOY_ENV == "staging") {
                        def allServices = sh(
                            script: "find . -name Dockerfile -not -path '*/node_modules/*' | sed 's|/Dockerfile||' | sed 's|^./||'",
                            returnStdout: true
                        ).trim().split("\n")
 
                        env.CHANGED_SERVICES = allServices.join(",")
                        echo "Staging release → build all services: ${env.CHANGED_SERVICES}"
                    } else {
                        def changedFiles = sh(
                            script: "git diff --name-only HEAD~1 HEAD 2>/dev/null || git diff --name-only HEAD",
                            returnStdout: true
                        ).trim().split("\n")

                        def services = []

                        for (file in changedFiles) {
                            def parts = file.tokenize("/")
                            if (parts.size() > 1) {
                                def svc = parts[0]
                                if (!services.contains(svc) && fileExists("${svc}/Dockerfile")) {
                                    services.add(svc)
                                }
                            }
                        }
                        
                        if (services.isEmpty()) {
                            echo "No service changed → skip build"
                            currentBuild.result = 'SUCCESS'
                            return
                        }
                        env.CHANGED_SERVICES = services.join(",")
                        echo "Changed services: ${env.CHANGED_SERVICES}"
                    }
                }
            }
        }
        
        stage('Build JAR') {
            when {
                expression { return env.CHANGED_SERVICES != null }
            }
            steps {
                script {
                    sh'''
                    chmod +x mvnw
                    '''
                    def services = env.CHANGED_SERVICES.split(',')
                    for (service in services) {
                        echo "Compile ${service}..."
                        // Chạy Maven Wrapper để build file .jar
                        // -DskipTests giúp bỏ qua việc chạy unit test để tăng tốc độ build
                        sh """
                        ./mvnw clean install -pl ${service} -am -DskipTests
                        """
                    }
                }
            }
        }

        stage('Docker Login') {
            when {
                expression { return env.CHANGED_SERVICES != null }
            }
            steps {
                withCredentials([usernamePassword(
                    credentialsId: DOCKERHUB_CREDS,
                    usernameVariable: 'USER',
                    passwordVariable: 'PASS'
                )]) {
                    sh '''
                    echo "$PASS" | docker login -u "$USER" --password-stdin
                    '''
                }
            }
        }

        stage('Build & Push Changed Services') {
            when {
                expression { return env.CHANGED_SERVICES != null }
            }
            steps {
                script {
                    def services = env.CHANGED_SERVICES.split(",")

                    for (svc in services) {
                        def image = "${DOCKERHUB_USR}/${svc}"

                        echo "Building ${svc}..."

                        sh """
                        docker build \
                            --no-cache \
                            -t ${image}:${COMMIT_ID} \
                            -f ${svc}/Dockerfile ./${svc}
                        """
                        retry(3) {
                            sh "docker push ${image}:${env.IMAGE_TAG}"
                        }
                        
                        if (env.DEPLOY_ENV == "dev") {
                            sh "docker tag ${image}:${env.IMAGE_TAG} ${image}:latest"
                            retry(3) {
                                sh "docker push ${image}:latest"
                            }
                        }
                    }
                }
            }
        }

        stage('Trigger Deploy') {
            when {
                expression { 
                    return env.CHANGED_SERVICES != null && env.DEPLOY_ENV != "none"
                }
            }
            steps {
                script {
                    build job: 'developer_deploy',
                        wait: false,
                        parameters: [
                            string(name: 'DEPLOY_ENV',       value: env.DEPLOY_ENV),
                            string(name: 'IMAGE_TAG',        value: env.IMAGE_TAG),
                            string(name: 'CHANGED_SERVICES', value: env.CHANGED_SERVICES)
                        ]
                }
            }
        }
    }

    post {
        always {
            script {
                if (env.CHANGED_SERVICES) {
                    def services = env.CHANGED_SERVICES.split(",")

                    for (svc in services) {
                        def image = "${DOCKERHUB_USR}/${svc}"
                        sh "docker rmi ${image}:${env.IMAGE_TAG} || true"
                        sh "docker rmi ${image}:latest || true"
                    }
                }
            }
        }
    }
}
