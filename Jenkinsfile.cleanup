pipeline {
    agent any
    parameters {
        string(name: 'SERVICE_NAME', defaultValue: '', description: 'Name of removed service. Empty to remove all.')
    }
    environment {
        NAMESPACE      = 'yas'
        DOCKERHUB_USER = 'bync'
    }
    stages {

        stage('Cleanup Helm Releases') {
            steps {
                script {
                    if (params.SERVICE_NAME?.trim()) {
                        echo "Delete service: ${params.SERVICE_NAME}"
                        sh """
                            helm uninstall ${params.SERVICE_NAME} \
                                --namespace ${NAMESPACE} 2>/dev/null || true
                        """
                    } else {
                        echo "Delete all services in namespace ${NAMESPACE}"
                        def releases = sh(
                            script: "helm list -n ${NAMESPACE} -q",
                            returnStdout: true
                        ).trim()

                        if (releases) {
                            releases.split('\n').each { release ->
                                sh "helm uninstall ${release.trim()} --namespace ${NAMESPACE} 2>/dev/null || true"
                            }
                        } else {
                            echo "There is no release in namespace ${NAMESPACE}"
                        }
                    }
                }
            }
        }

        stage('Cleanup Images') {
            steps {
                script {
                    def imageFilter = params.SERVICE_NAME?.trim()
                        ? "${DOCKERHUB_USER}/${params.SERVICE_NAME}"
                        : "${DOCKERHUB_USER}/"

                    writeFile file: 'image-cleanup-ds.yaml', text: """
apiVersion: apps/v1
kind: DaemonSet
metadata:
name: image-cleanup
namespace: default
spec:
selector:
    matchLabels:
    app: image-cleanup
template:
    metadata:
    labels:
        app: image-cleanup
    spec:
    hostPID: true
    tolerations:
    - operator: Exists
    volumes:
    - name: containerd-sock
        hostPath:
        path: /run/containerd/containerd.sock
        type: Socket
    - name: crictl-bin
        hostPath:
        path: /usr/local/bin/crictl
        type: File
    containers:
    - name: cleanup
        image: alpine:3.18
        command:
        - sh
        - -c
        - |
        echo "Cleaning images matching: ${imageFilter}"
        /usr/local/bin/crictl --runtime-endpoint unix:///run/containerd/containerd.sock images \\
            | grep '${imageFilter}' \\
            | awk '{print \$3}' \\
            | sort -u \\
            | xargs -r /usr/local/bin/crictl --runtime-endpoint unix:///run/containerd/containerd.sock rmi || true
        /usr/local/bin/crictl --runtime-endpoint unix:///run/containerd/containerd.sock rmi --prune || true
        echo "Cleanup done on node"
        sleep infinity
        securityContext:
        privileged: true
        volumeMounts:
        - name: containerd-sock
        mountPath: /run/containerd/containerd.sock
        - name: crictl-bin
        mountPath: /usr/local/bin/crictl
"""
                    sh "kubectl apply -f image-cleanup-ds.yaml"

                    sh """
                        for i in \$(seq 1 36); do
                            DESIRED=\$(kubectl get daemonset image-cleanup -n default -o jsonpath='{.status.desiredNumberScheduled}')
                            READY=\$(kubectl get daemonset image-cleanup -n default -o jsonpath='{.status.numberReady}')
                            echo "Waiting... desired=\$DESIRED ready=\$READY"
                            if [ "\$DESIRED" = "\$READY" ] && [ "\$DESIRED" != "0" ]; then
                                echo "All nodes cleaned up!"
                                break
                            fi
                            sleep 5
                        done
                    """

                    sh "kubectl delete daemonset image-cleanup -n default --ignore-not-found || true"
                    sh "rm -f image-cleanup-ds.yaml"
                }
            }
        }

        stage('Verify') {
            steps {
                sh "helm list -n ${NAMESPACE}"
                sh "kubectl get pods -n ${NAMESPACE}"
            }
        }
    }
}
