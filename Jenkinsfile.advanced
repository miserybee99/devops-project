pipeline {
    agent any
    parameters {
        string(name: 'DEPLOY_ENV',       defaultValue: 'dev')
        string(name: 'COMMIT_ID',        defaultValue: 'latest')
        string(name: 'IMAGE_TAG',        defaultValue: 'latest')
        string(name: 'CHANGED_SERVICES', defaultValue: '')
    }
    environment {
        GITHUB_CREDS = "gitops-credentials"
        GITHUB_REPO = "Phuc-215/yas-deploy.git"
    }
    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: "https://github.com/${GITHUB_REPO}",
                    credentialsId: GITHUB_CREDS
            }
        }

        stage('Update Dev Overlay') {
            when {
                expression { return params.DEPLOY_ENV == "dev" }
            }
            steps {
                script {
                    def services = params.CHANGED_SERVICES.split(",")
                    withCredentials([usernamePassword(
                        credentialsId: GITHUB_CREDS,
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_TOKEN'
                    )]) {
                        sh """
                            git config user.email "jenkins@yas.local"
                            git config user.name  "Jenkins"
                        """
                        for (svc in services) {
                            svc = svc.trim()
                            sh """
                                yq -i '.backend.image.tag = "${params.COMMIT_ID}"' \
                                    overlays/dev/${svc}.yaml
                            """
                        }
                        sh """
                            git add overlays/dev/
                            git diff --cached --quiet || git commit -m "cd: [dev] update ${params.CHANGED_SERVICES} to ${params.COMMIT_ID} [skip ci]"
                            git push https://\${GIT_USER}:\${GIT_TOKEN}@github.com/\${GITHUB_REPO} main
                        """
                    }
                }
            }
        }

        stage('Update Staging Overlay') {
            when {
                expression { return params.DEPLOY_ENV == "staging" }
            }
            steps {
                script {
                    def services = params.CHANGED_SERVICES.split(",")
                    withCredentials([usernamePassword(
                        credentialsId: GITHUB_CREDS,
                        usernameVariable: 'GIT_USER',
                        passwordVariable: 'GIT_TOKEN'
                    )]) {
                        sh """
                            git pull https://\${GIT_USER}:\${GIT_TOKEN}@github.com/\${GITHUB_REPO} main
                        """
                        for (svc in services) {
                            svc = svc.trim()
                            sh """
                                yq -i '.backend.image.tag = "${params.IMAGE_TAG}"' \
                                    overlays/staging/${svc}.yaml
                            """
                        }
                        sh """
                            git add overlays/staging/
                            git diff --cached --quiet || git commit -m "cd: [staging] update ${params.CHANGED_SERVICES} to ${params.IMAGE_TAG} [skip ci]"
                            git push https://\${GIT_USER}:\${GIT_TOKEN}@github.com/\${GITHUB_REPO} main
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "CD completed successfully!"
        }
        failure {
            echo "CD failed. Watch logs for details."
        }
    }
}
